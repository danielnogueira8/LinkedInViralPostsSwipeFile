{
  "name": "linkedin-swipe-scaffold",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run mcp-app:build && next build",
    "start": "next start",
    "lint": "eslint",
    "test:evals": "vitest run",
    "test:evals:watch": "vitest",
    "test:coverage": "node scripts/coverage-summary.mjs",
    "test:coverage:focused": "node scripts/check-focused-coverage.mjs",
    "e2e": "playwright test",
    "e2e:mcp-app": "playwright test --config playwright.mcp.config.ts",
    "e2e:ui": "playwright test ui-loading.spec.ts",
    "e2e:critical": "playwright test critical-journeys.spec.ts swipe-bookmark-workflows.spec.ts client-reconciliation.spec.ts draft-lifecycle.spec.ts",
    "e2e:critical:ci": "npm run e2e:mcp-app && playwright test critical-journeys.spec.ts swipe-bookmark-workflows.spec.ts client-reconciliation.spec.ts draft-lifecycle.spec.ts && node scripts/assert-no-playwright-flakes.mjs",
    "e2e:smoke": "playwright test smoke.spec.ts",
    "load:smoke": "node scripts/load-smoke.mjs",
    "migrations:metadata": "node scripts/check-migrations.mjs --write",
    "migrations:check": "node scripts/check-migrations.mjs",
    "migrations:readiness": "node scripts/migration-readiness.mjs",
    "mcp-app:build": "node scripts/build-mcp-swipe-app.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.114.0",
    "@base-ui/react": "^1.4.1",
    "@clerk/mcp-tools": "^0.6.0",
    "@clerk/nextjs": "^7.3.7",
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/server": "^2.0.0",
    "@paper-design/shaders-react": "0.0.77",
    "@sentry/nextjs": "^10.65.0",
    "@supabase/supabase-js": "^2.105.4",
    "apify-client": "^2.23.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "fflate": "^0.8.3",
    "jose": "^6.2.3",
    "lucide-react": "^1.16.0",
    "mammoth": "^1.11.0",
    "next": "16.2.12",
    "next-themes": "^0.4.6",
    "pdf-parse": "^1.1.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "4.7.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@clerk/testing": "^2.1.7",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.41",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^3.2.6",
    "esbuild": "^0.25.12",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.6"
  },
  "overrides": {
    "@hono/node-server": "2.0.12",
    "axios": "1.18.1",
    "body-parser": "2.3.0",
    "brace-expansion": "5.0.8",
    "fast-uri": "3.1.4",
    "minimatch": "10.2.5",
    "postcss": "8.5.18",
    "sharp": "0.35.0"
  }
}
